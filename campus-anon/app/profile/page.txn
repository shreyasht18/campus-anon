"use client";

import { useState, useEffect } from "react";
import { createClient } from "@supabase/supabase-js";
import { Flame, MessageSquare, ThumbsUp } from "lucide-react";

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL || "",
  process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || ""
);

interface Post { id: string; content: string; created_at: string; upvotes: number; downvotes: number; }

export default function ProfilePage() {
  const [username, setUsername] = useState("Anonymous_Student");
  const [userPosts, setUserPosts] = useState<Post[]>([]);
  const [totalKarma, setTotalKarma] = useState(0);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const fetchUserData = async () => {
      const { data: { user } } = await supabase.auth.getUser();
      if (user?.user_metadata?.display_name) {
        const currentName = user.user_metadata.display_name;
        setUsername(currentName);

        const { data } = await supabase.from("posts").select("*").eq("author_name", currentName).order("created_at", { ascending: false });
        if (data) {
          setUserPosts(data);
          const karma = data.reduce((acc, post) => acc + (post.upvotes || 0) - (post.downvotes || 0), 0);
          setTotalKarma(karma);
        }
      }
      setLoading(false);
    };
    fetchUserData();
  }, []);

  return (
    <div className="pb-24 md:pb-8">
      <div className="sticky top-0 z-40 bg-[#0c0c0f]/80 backdrop-blur-xl border-b border-white/5 p-6 flex items-end gap-4 h-32">
        <div className="w-16 h-16 rounded-full bg-indigo-600 flex items-center justify-center text-2xl font-black text-white border-4 border-[#0c0c0f] shadow-lg shadow-indigo-500/20 translate-y-4">
          {username[0].toUpperCase()}
        </div>
        <div className="pb-1">
          <h1 className="text-xl font-bold text-white tracking-tight">{username}</h1>
          <p className="text-xs text-zinc-500">Secured Node Identity</p>
        </div>
      </div>

      <div className="p-4 md:p-6 mt-4 space-y-6">
        <div className="grid grid-cols-2 gap-4">
          <div className="bg-white/5 border border-white/5 rounded-2xl p-4">
            <div className="text-zinc-500 text-xs font-medium mb-1 flex items-center gap-1.5"><Flame className="w-3.5 h-3.5 text-orange-500" /> Total Karma</div>
            <div className="text-2xl font-bold text-white">{totalKarma}</div>
          </div>
          <div className="bg-white/5 border border-white/5 rounded-2xl p-4">
            <div className="text-zinc-500 text-xs font-medium mb-1 flex items-center gap-1.5"><MessageSquare className="w-3.5 h-3.5 text-blue-400" /> Confessions</div>
            <div className="text-2xl font-bold text-white">{userPosts.length}</div>
          </div>
        </div>

        <div>
          <h2 className="text-sm font-bold text-zinc-300 mb-4 uppercase tracking-widest">Your Activity</h2>
          {loading ? (
             <div className="text-xs text-zinc-600">Loading...</div>
          ) : userPosts.length === 0 ? (
            <div className="text-xs text-zinc-600 bg-white/5 p-4 rounded-xl text-center">No posts found for this identity.</div>
          ) : (
            <div className="space-y-3">
              {userPosts.map((post) => (
                <div key={post.id} className="bg-[#121216] border border-white/5 rounded-xl p-4">
                  <p className="text-zinc-200 text-sm mb-3">{post.content}</p>
                  <div className="flex justify-between items-center text-xs text-zinc-500 border-t border-white/5 pt-2">
                    <span>{new Date(post.created_at).toLocaleDateString()}</span>
                    <span className="flex items-center gap-1 text-emerald-400"><ThumbsUp className="w-3 h-3" /> {(post.upvotes || 0) - (post.downvotes || 0)}</span>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}